# ==============================================================================
# Vrate Environment Variables Template
# ==============================================================================
# NOTE: Copy this file to .env.local for local development.
# NEVER commit .env.local or any secret keys to version control.
# ==============================================================================

# Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are safe for client-side exposure.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECURITY WARNING:
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security (RLS).
# MUST NEVER be exposed to browser/client-side or the extension.
SUPABASE_SERVICE_ROLE_KEY=

# Metadata Providers
# TMDB API Read Access Token (v4 auth).
# In future steps, this must only be used on the server-side, never exposed to clients.
TMDB_API_READ_TOKEN=

# AniList GraphQL API Endpoint (public metadata endpoint; not a secret)
ANILIST_API_URL=https://graphql.anilist.co

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
# Set to true only after configuring Google provider in Supabase Dashboard
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

