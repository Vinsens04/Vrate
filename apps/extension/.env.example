# ==============================================================================
# Vrate Chrome Extension Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local extension development.
# NEVER commit .env.local or any secret keys to version control.
# ==============================================================================

# Supabase Configuration
# Only the public project URL and public anon key may be exposed in the extension bundle.
# SECURITY WARNING: NEVER put SUPABASE_SERVICE_ROLE_KEY here!
WXT_PUBLIC_SUPABASE_URL=
WXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Application URL (used for links to dashboard, register, forgot-password)
WXT_PUBLIC_WEB_APP_URL=http://localhost:3000
