# ==============================================================================
# Vrate Web Application Environment Variables (.env.local template)
# ==============================================================================
# Copy this file to apps/web/.env.local for local development.
# Next.js App Router specifically reads from apps/web/.env.local.
# NEVER commit .env.local to Git.
# ==============================================================================

# Supabase Client Configuration (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only Secret (Bypasses RLS)
# WARNING: NEVER expose to client components or extension!
SUPABASE_SERVICE_ROLE_KEY=

# TMDB API Read Access Token (v4 auth - server-side only in future steps)
TMDB_API_READ_TOKEN=

# AniList GraphQL API Endpoint (public metadata endpoint)
ANILIST_API_URL=https://graphql.anilist.co

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
# Set to true only after configuring Google provider in Supabase Dashboard
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

