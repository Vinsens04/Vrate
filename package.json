{
  "name": "vrate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @vrate/web --filter @vrate/extension dev",
    "dev:web": "pnpm --filter @vrate/web dev",
    "dev:extension": "pnpm --filter @vrate/extension dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --linked > apps/web/src/types/database.types.ts",
    "db:types:local": "supabase gen types typescript --local > apps/web/src/types/database.types.ts",
    "test:auth": "node --experimental-strip-types --test apps/web/src/features/auth/utils/auth-logic.test.ts",
    "test:library": "node --experimental-strip-types --test apps/web/src/features/library/utils/library-logic.test.ts",
    "test:catalog": "node --experimental-strip-types --test apps/web/src/features/catalog/providers/tmdb/tmdb.test.ts apps/web/src/features/catalog/providers/anilist/anilist.test.ts apps/web/src/features/catalog/utils/catalog-logic.test.ts",
    "test:extension-auth": "node --experimental-strip-types --test apps/extension/src/auth/extension-auth.test.ts apps/web/src/lib/extension-auth/extension-cors-token.test.ts",
    "test:detection": "node --experimental-strip-types --test apps/extension/src/detection/detection.test.ts apps/web/src/lib/extension-auth/extension-detection-api.test.ts",
    "test:tracking": "node --experimental-strip-types --test apps/extension/src/tracking/tracking.test.ts apps/web/src/lib/extension-auth/extension-tracking-api.test.ts"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "eslint": "^10.10.0",
    "supabase": "^2.116.0",
    "typescript-eslint": "^8.69.0"
  }
}
